[sqlfluff]
dialect = ansi
max_line_length = 100
exclude_rules = 
templater = jinja

[sqlfluff:layout:type]
# Uppercase keywords (SELECT, FROM, WHERE, etc.)
extended_capitalisation_policy = upper

[sqlfluff:layout:identifier]
# Lowercase identifiers (table names, column names)
extended_capitalisation_policy = lower
# Keep vendor-specific tokens/quotes as written
unquoted_identifiers_policy = all
quoted_identifiers_policy = none

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower
# Preserve quoted identifiers as-is
ignore_words_regex = ^.*$

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:indentation]
indent_unit = space
indent_width = 2

[sqlfluff:layout:type:comma]
line_position = leading

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = true
# Wrap at 100 characters
max_line_length = 100

[sqlfluff:rules:layout.select_targets]
wildcard_policy = multiple

[sqlfluff:rules:structure.distinct]
single_table_references = unqualified

[sqlfluff:rules:layout.cte_bracket]
# Preserve newlines around CTEs
cte_bracket_style = separate_lines

[sqlfluff:rules:layout.select_modifiers]
# One clause per line
force_enable = true

[sqlfluff:rules:references.special_chars]
# Keep vendor tokens and special characters as written
unquoted_identifiers_policy = all
quoted_identifiers_policy = none
allow_space_in_identifier = false

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit
# Require AS keyword for column aliases
aliasing_required = true

[sqlfluff:rules:aliasing.expression]
# Require AS for expression aliases
allow_implicit_aliases = false

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = explicit

[sqlfluff:rules:structure.subquery]
forbid_subquery_in = both

[sqlfluff:rules:layout.set_operators]
# One clause per line for UNION, INTERSECT, etc.
line_position = alone

[sqlfluff:rules:layout.joins]
# Preserve newlines around JOIN blocks
allow_implicit = false

[sqlfluff:rules:ambiguous.join]
# Forbid implicit joins via comma, require explicit JOIN
fully_qualify_join_types = both

[sqlfluff:rules:structure.join_condition_order]
# Enforce explicit JOIN syntax
preferred_first_table_in_join_clause = earlier

[sqlfluff:rules:ambiguous.select]
# Forbid SELECT * wildcard in production
wildcard_policy = none

[sqlfluff:rules:layout.end_of_file]
# Require semicolon at end of statements
require_final_semicolon = true

[sqlfluff:rules:convention.terminator]
# Require semicolons to terminate statements
multiline_newline = true
require_final_semicolon = true

[sqlfluff:rules:ambiguous.order_by]
# Enforce deterministic ORDER BY when LIMIT is used
require_order_by_when_limit = true

# ==== Additional best practice rules (not in original) ====

# Additional best practice rules

[sqlfluff:rules:layout.operators]
# Consistent spacing around operators
operator_new_lines = after

[sqlfluff:rules:structure.column_order]
# Enforce consistent column ordering in SELECT
leading_columns = id, name, created_at, updated_at

[sqlfluff:rules:convention.count_rows]
# Use COUNT(*) instead of COUNT(1) or COUNT(column)
prefer_count_1 = false
prefer_count_0 = false

[sqlfluff:rules:convention.select_trailing_comma]
# Enforce trailing commas in SELECT for easier diffs
select_clause_trailing_comma = require

[sqlfluff:rules:convention.left_join]
# Prefer LEFT JOIN over RIGHT JOIN for readability
prefer_left_join = true

[sqlfluff:rules:convention.coalesce]
# Use COALESCE instead of IFNULL/ISNULL for portability
prefer_coalesce = true

[sqlfluff:rules:convention.casting]
# Use CAST over :: for ANSI compliance
prefer_cast_function_style = true

[sqlfluff:rules:structure.using]
# Prefer ON over USING in joins for clarity
prefer_using_in_join_criteria = false

[sqlfluff:rules:references.from_clause]
# Enforce table references in FROM clause
force_enable = true

[sqlfluff:rules:references.qualification]
# Require table qualification for columns in multi-table queries
single_table_references = unqualified
multi_table_references = qualified

[sqlfluff:rules:references.consistent]
# Enforce consistent table references throughout query
single_table_references = consistent

[sqlfluff:rules:layout.spacing]
# Consistent spacing rules
spacing_before = true
spacing_after = true
spacing_within = single

[sqlfluff:rules:layout.functions]
# No spaces between function name and parentheses
no_space_after_function_name = true

[sqlfluff:rules:convention.unnecessary_case]
# Avoid unnecessary CASE statements
forbid_case_with_single_when = true

[sqlfluff:rules:convention.not_equal]
# Use <> instead of != for ANSI compliance
prefer_ansi_not_equal_style = true

[sqlfluff:rules:structure.else_null]
# Require explicit ELSE NULL in CASE statements
require_else = true

[sqlfluff:rules:structure.grouping]
# Enforce parentheses in complex boolean logic
require_parentheses_in_conditions = true

[sqlfluff:rules:convention.quoted_literals]
# Use single quotes for string literals
prefer_single_quotes = true

[sqlfluff:rules:convention.null_ordering]
# Explicit NULL ordering in ORDER BY
require_explicit_nulls_ordering = true

[sqlfluff:rules:structure.unused_cte]
# Flag unused CTEs
forbid_unused_cte = true

[sqlfluff:rules:structure.duplicate_cte]
# Forbid duplicate CTE names
forbid_duplicate_cte_names = true

[sqlfluff:rules:convention.implicit_conversion]
# Warn about implicit type conversions
warn_on_implicit_conversion = true

[sqlfluff:rules:convention.union]
# Prefer UNION ALL over UNION when duplicates are acceptable
prefer_union_all = true

[sqlfluff:rules:structure.nested_case]
# Limit nesting depth of CASE statements
max_nesting_depth = 3

[sqlfluff:rules:references.keywords]
# Don't use keywords as identifiers
forbid_reserved_words_as_identifiers = true

[sqlfluff:rules:convention.date_literals]
# Enforce ISO 8601 date format (YYYY-MM-DD)
enforce_iso_date_format = true

[sqlfluff:rules:structure.subquery_nesting]
# Limit subquery nesting depth
max_subquery_depth = 2

[sqlfluff:rules:convention.between]
# Prefer BETWEEN over >= AND <=
prefer_between = true

[sqlfluff:rules:convention.exists]
# Prefer EXISTS over IN for subqueries
prefer_exists_over_in = true

[sqlfluff:rules:structure.having]
# Only use HAVING for aggregate conditions
restrict_having_to_aggregates = true

[sqlfluff:rules:convention.window_functions]
# Named window definitions for complex queries
prefer_window_clause = true

[sqlfluff:rules:layout.blank_lines]
# Blank lines between major query sections
blank_line_after_cte = true
blank_line_between_queries = true

[sqlfluff:rules:convention.boolean]
# Use TRUE/FALSE instead of 1/0 for booleans
prefer_boolean_literals = true

[sqlfluff:rules:structure.distinct_on]
# Warn about DISTINCT without explicit columns
require_distinct_columns = true

[sqlfluff:rules:convention.numeric_literals]
# No leading zeros in numeric literals
forbid_leading_zeros = true

[sqlfluff:rules:structure.foreign_key]
# Enforce foreign key naming conventions
foreign_key_pattern = fk_.*

[sqlfluff:rules:structure.primary_key]
# Enforce primary key naming conventions
primary_key_pattern = pk_.*

[sqlfluff:rules:structure.index]
# Enforce index naming conventions
index_pattern = idx_.*

[sqlfluff:rules:convention.table_naming]
# Enforce table naming conventions (lowercase, underscore)
table_pattern = [a-z][a-z0-9_]*

[sqlfluff:rules:convention.column_naming]
# Enforce column naming conventions (lowercase, underscore)
column_pattern = [a-z][a-z0-9_]*
